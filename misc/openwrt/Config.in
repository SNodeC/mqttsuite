menu "MQTTSuite build options"

comment "Select applications and mapping plugins in Network / MQTTSuite"
comment "The mqttsuite package selects all applications and mapping plugins; transports are compile-time options"

menu "mqttbroker transports"
    visible if PACKAGE_mqttsuite-broker

config MQTTSUITE_BROKER_TCP_IPV4
    bool "TCP (IPv4)" if MQTTSUITE_BROKER_TCP_IPV6 || MQTTSUITE_BROKER_UNIX
    default y

config MQTTSUITE_BROKER_TLS_IPV4
    bool "TLS (IPv4)"
    depends on MQTTSUITE_BROKER_TCP_IPV4
    default y

config MQTTSUITE_BROKER_TCP_IPV6
    bool "TCP (IPv6)"
    default y

config MQTTSUITE_BROKER_TLS_IPV6
    bool "TLS (IPv6)"
    depends on MQTTSUITE_BROKER_TCP_IPV6
    default y

config MQTTSUITE_BROKER_UNIX
    bool "Unix domain sockets"
    default y

config MQTTSUITE_BROKER_UNIX_TLS
    bool "TLS (Unix domain sockets)"
    depends on MQTTSUITE_BROKER_UNIX
    default n

config MQTTSUITE_BROKER_WS
    bool "WebSocket"
    depends on MQTTSUITE_BROKER_TCP_IPV4 || MQTTSUITE_BROKER_TCP_IPV6 || MQTTSUITE_BROKER_UNIX
    default y

config MQTTSUITE_BROKER_WSS
    bool "Secure WebSocket"
    depends on MQTTSUITE_BROKER_WS
    depends on MQTTSUITE_BROKER_TLS_IPV4 || MQTTSUITE_BROKER_TLS_IPV6 || MQTTSUITE_BROKER_UNIX_TLS
    default y

comment "IPv4 TCP is required when both IPv6 and Unix sockets are disabled"
    depends on !MQTTSUITE_BROKER_TCP_IPV4 && !MQTTSUITE_BROKER_TCP_IPV6 && !MQTTSUITE_BROKER_UNIX
endmenu

