#!/bin/sh /etc/rc.common

START=50
STOP=90
USE_PROCD=1

start_service() {
        procd_open_instance
        procd_set_param command /usr/bin/mqttintegrator --daemonize=false --quiet=false --enforce-log-file=false
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_set_param respawn
        procd_close_instance
}
